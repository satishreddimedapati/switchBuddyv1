
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allows read/write access to job applications
    match /job-applications/{document=**} {
      allow read, write: if true;
    }

    // Allows read/write access to daily tasks
    match /daily_tasks/{document=**} {
      allow read, write: if true;
    }
    
      match /interview_plans/{document=**} {
      allow read, write: if true;
    }
    
     match /interview_sessions/{document=**} {
      allow read, write: if true;
    }
    
     match /redeemed_rewards/{document=**} {
      allow read, write: if true;
    }
    
     match /learning_roadmaps/{document=**} {
      allow read, write: if true;
    }
    
    match /chat_sessions/{document=**} {
      allow read, write: if true;
    }

    match /interview-experiences/{document=**} {
      allow read, write: if true;
    }
    
    
  }
}
